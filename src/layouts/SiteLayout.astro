---
import BaseHead from "../components/BaseHead.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import type { CV } from "../data/types";
import "../styles/site.css";

interface Props {
  cv: CV;
}

const { cv } = Astro.props;
const { labels } = cv;
const path = `/${cv.locale}/`;
/*
 * Every string on this page comes from the locale's own labels.
 *
 * There was a boolean here — `isPtBr` — and everything it touched read as
 * "Portuguese, or else English". A third language turned that into a bug you
 * could see: the Spanish page rendered with English chrome.
 */
---

<!doctype html>
<html lang={cv.lang}>
  <head>
    <BaseHead cv={cv} path={path} />
    <script is:inline>
      /* Applied before first paint so the stored theme never flashes. */
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          }
        } catch (error) {
          /* storage blocked; the system preference still applies */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{labels.skipToContent}</a>

    <div class="toolbar">
      {/*
        A barra atravessa a tela; o conteúdo dela, não.
        Sem este invólucro as pílulas seguiam a borda da janela, e num monitor
        largo iam parar longe do currículo, que para em 1180px. A moldura
        continua de ponta a ponta — é o que a faz parecer uma barra — e o que
        está dentro segue a mesma coluna do texto.
      */}
      <div class="toolbar__inner">
        {/*
          Só o que não está repetido na página.
          A barra trazia IMPRESSÃO, PDF e DOCX, e os três já são botões no
          cabeçalho, a um rolar de distância. Com seis idiomas ela passou da
          largura de um telemóvel e quebrou em duas linhas para mostrar
          duplicatas. O que sobra é o que existe só aqui: onde se está, com a
          volta para trocar de idioma, e o tema.
        */}
        <nav class="toolbar__group">
          <a class="toolbar__link" href="/" aria-label={labels.languageSwitch}>
            <span aria-hidden="true">←</span> {labels.languageName}
          </a>
        </nav>

        <ThemeSwitch labels={labels} />
      </div>
    </div>

    <slot />

    <script is:inline>
      (function () {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduceMotion && "IntersectionObserver" in window) {
          /* Only sections starting below the fold are hidden, so what is already
             on screen never depends on the observer firing. */
          const revealables = Array.from(document.querySelectorAll("main .section")).filter(
            (element) => element.getBoundingClientRect().top > window.innerHeight * 0.9
          );
          revealables.forEach((element) => element.classList.add("is-revealable"));

          /* Safety net: if anything keeps a section from being observed, show it. */
          window.setTimeout(() => {
            revealables.forEach((element) => element.classList.add("is-revealed"));
          }, 2500);
          const revealer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-revealed");
                revealer.unobserve(entry.target);
              });
            },
            { rootMargin: "0px 0px -8% 0px" }
          );
          revealables.forEach((element) => revealer.observe(element));
        }

        const links = Array.from(document.querySelectorAll(".rail__index a"));
        const sections = Array.from(document.querySelectorAll("main .section"));

        if (links.length && sections.length) {
          /*
           * Position based rather than IntersectionObserver: an observer band
           * near the top of the viewport is never reached by the last section,
           * because the page runs out of scroll first.
           */
          const activeSectionId = () => {
            const documentHeight = document.documentElement.scrollHeight;
            const atBottom = window.scrollY + window.innerHeight >= documentHeight - 2;
            if (atBottom) return sections[sections.length - 1].id;

            const line = window.scrollY + window.innerHeight * 0.3;
            let current = sections[0].id;
            for (const section of sections) {
              if (section.getBoundingClientRect().top + window.scrollY <= line) current = section.id;
            }
            return current;
          };

          let queued = false;
          const sync = () => {
            queued = false;
            const id = activeSectionId();
            links.forEach((link) => {
              link.classList.toggle("is-active", link.getAttribute("href") === "#" + id);
            });
          };

          const onScroll = () => {
            if (queued) return;
            queued = true;
            window.requestAnimationFrame(sync);
          };

          window.addEventListener("scroll", onScroll, { passive: true });
          window.addEventListener("resize", onScroll, { passive: true });
          sync();
        }
      })();
    </script>
  </body>
</html>

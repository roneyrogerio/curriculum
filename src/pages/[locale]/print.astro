---
import ResumeSheet from "../../components/ResumeSheet.astro";
import { allLocales, cvByLocale } from "../../data";
import PrintLayout from "../../layouts/PrintLayout.astro";
import { documentOf } from "../../lib/resume";
import type { Locale } from "../../data/types";

export function getStaticPaths() {
  return allLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const cv = cvByLocale[locale];
---

<PrintLayout cv={cv}>
  <ResumeSheet document={documentOf(cv)} />
</PrintLayout>

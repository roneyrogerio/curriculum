---
/*
 * The 404, which is the language gate with a different heading.
 *
 * It used to offer two languages of the six, written out by hand — Portuguese
 * and American English. Nothing was wrong with either link; they were simply
 * the two that existed when the page was written, and a visitor who arrived
 * here from the French CV was shown the way to the Brazilian one.
 *
 * So the list is built from the locales that exist, exactly as `index.astro`
 * builds its own. Adding a language stays one edit, in `src/data`.
 */
import Analytics from "../components/Analytics.astro";
import { allLocales, cvByLocale } from "../data";
import { siteUrl } from "../data/site";
import "../styles/site.css";

const options = allLocales.map((locale) => {
  const cv = cvByLocale[locale];
  return {
    locale,
    code: locale.toUpperCase(),
    label: cv.labels.languageLabel,
    note: cv.labels.gateNote,
    lang: cv.hreflang
  };
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Página não encontrada — Roney de Oliveira</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <Analytics group="not-found" />
  </head>
  <body class="gate-body">
    <main class="gate">
      <p class="eyebrow">404</p>
      <h1 class="gate__name">Página não encontrada</h1>
      <p class="gate__role">This page does not exist</p>
      <ul class="gate__options">
        {options.map((option) => (
          <li>
            <a
              class="gate__option"
              href={`/${option.locale}/`}
              hreflang={option.lang}
              lang={option.lang}
            >
              <span class="gate__code">{option.code}</span>
              <span class="gate__label">{option.label}</span>
              <span class="gate__note">{option.note}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="gate__foot"><a href={`${siteUrl}/`}>roneyrogerio.dev</a></p>
    </main>
  </body>
</html>

---
import { jsonForScript } from "../lib/markup";
/*
 * Language selector, and the x-default target.
 *
 * Google asks sites not to redirect automatically between language versions,
 * because that stops users and crawlers from reaching the other versions:
 * Googlebot crawls from the USA and sends no Accept-Language header, so
 * detection would always resolve to the same version. The page suggests a
 * language instead of forcing one.
 */
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { allLocales, cvByLocale } from "../data";
import { siteUrl } from "../data/site";
import "../styles/site.css";

/*
 * Built from the locales that exist, in their own words.
 *
 * The list used to be written here, which meant a new language was three
 * edits: the data file, this array, and the hreflang tags below. Two of them
 * were easy to forget, and forgetting them is invisible — the page still
 * renders, just without the language anyone came for.
 */
const options = allLocales.map((locale) => {
  const cv = cvByLocale[locale];
  return {
    locale,
    code: locale.toUpperCase(),
    label: cv.labels.languageLabel,
    note: cv.labels.gateNote,
    suggested: cv.labels.gateSuggested,
    lang: cv.hreflang
  };
});

/* The gate has no language of its own, so its chrome speaks the site default. */
const { labels } = cvByLocale["pt-br"];

/*
 * Os idiomas oferecidos, nos nomes deles, para o título e a descrição.
 * Escritos à mão, os dois anunciavam "PT-BR / EN-US / ES-ES" — uma lista
 * desatualizada citando um código que já não existe. Ninguém repara numa
 * descrição velha; ela só aparece no resultado de busca.
 */
const offered = options.map((option) => option.label).join(", ");

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: `${siteUrl}/`,
  name: "Roney de Oliveira",
  inLanguage: options.map((option) => option.lang),
  about: { "@id": `${siteUrl}/#person` }
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Roney de Oliveira — Software Engineer | Currículo · CV · Resume</title>
    <meta
      name="description"
      content={`Currículo de Roney de Oliveira, Software Engineer backend, full stack e DevOps. Disponível em ${offered}.`}
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}/`} />
    {options.map((option) => (
      <link rel="alternate" hreflang={option.lang} href={`${siteUrl}/${option.locale}/`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Roney de Oliveira — Software Engineer" />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta name="theme-color" content="#0a7c72" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f12" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <script is:inline type="application/ld+json" set:html={jsonForScript(schema)} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") document.documentElement.dataset.theme = stored;
        } catch (error) {
          /* storage blocked; the system preference still applies */
        }
      })();
    </script>
  </head>
  <body class="gate-body">
    <main class="gate">
      {/*
        O seletor de tema mora aqui, na linha do título e dentro da mesma
        coluna das opções: esta é a primeira página que alguém abre, e ela
        tinha o script que restaura um tema salvo sem ter como escolher um.
        Solto no canto da janela ele não se alinhava com nada.
      */}
      <div class="gate__top">
        <p class="eyebrow">Curriculum vitae</p>
        <ThemeSwitch labels={labels} />
      </div>
      <h1 class="gate__name">{cvByLocale["pt-br"].name}</h1>
      <p class="gate__role">Software Engineer · Backend · Full Stack · DevOps</p>

      <ul class="gate__options">
        {options.map((option) => (
          <li>
            <a class="gate__option" href={`/${option.locale}/`} hreflang={option.lang} lang={option.lang}>
              <span class="gate__code">{option.code}</span>
              <span class="gate__label">{option.label}</span>
              <span class="gate__note">{option.note}</span>
              {/*
                Presente nos seis, visível em um. Escondê-lo com `hidden`
                tirava a linha do fluxo e o cartão sugerido ficava mais alto
                que os outros — a sugestão mexia no desenho da página em vez
                de só apontar. O CSS reserva o espaço e alterna a visibilidade.
              */}
              <span class="gate__suggested">{option.suggested}</span>
            </a>
          </li>
        ))}
      </ul>

      {/*
        Sem atalho para PDF aqui.
        Havia um, e ele apontava para /pt-br/print/ — escolhia o português por
        quem ainda não escolheu idioma nenhum, que é a única coisa que esta
        página faz. Apontá-lo para o idioma sugerido seria um link que muda
        conforme o navegador de quem olha, e continuaria escolhendo. Os dois
        formatos estão a um clique de dentro de qualquer uma das seis opções,
        já no idioma certo. GitHub e LinkedIn ficam: não têm idioma.
      */}
      <p class="gate__foot">
        <a href="https://github.com/roneyrogerio" target="_blank" rel="noopener noreferrer nofollow">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.linkedin.com/in/roneyrogerio/" target="_blank" rel="noopener noreferrer nofollow">LinkedIn</a>
      </p>
    </main>

    <script is:inline>
      /* Suggests a language without redirecting: every version stays reachable. */
      (function () {
        var options = Array.prototype.slice.call(document.querySelectorAll(".gate__option"));
        if (!options.length) return;

        function tagOf(option) {
          return (option.getAttribute("hreflang") || "").toLowerCase();
        }

        /*
         * navigator.languages, in order, and not navigator.language alone:
         * someone browsing in English with Portuguese second should be
         * offered English, and someone with only "pt" should still land on
         * Portuguese. An exact tag wins over a bare language, so "pt-pt"
         * reaches Portugal rather than Brazil.
         */
        var preferences = (navigator.languages && navigator.languages.length
          ? navigator.languages
          : [navigator.language || "pt"]
        ).map(function (tag) {
          return String(tag).toLowerCase();
        });

        var match = null;
        for (var i = 0; i < preferences.length && !match; i += 1) {
          var wanted = preferences[i];
          match =
            options.filter(function (option) {
              return tagOf(option) === wanted;
            })[0] ||
            options.filter(function (option) {
              return tagOf(option).split("-")[0] === wanted.split("-")[0];
            })[0] ||
            null;
        }

        if (match) match.classList.add("is-suggested");
      })();
    </script>
  </body>
</html>

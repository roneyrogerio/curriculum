---
import type { CV } from "../data/types";
import { inlineCode } from "../lib/markup";
import { headlineOf } from "../lib/headline";

interface Props {
  cv: CV;
}

const { cv } = Astro.props;
const { labels, contact } = cv;


const bare = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");

/*
 * Rendered as an array with explicit separators: Astro strips the whitespace
 * between adjacent elements, and without a space there is no soft wrap
 * opportunity, so the whole line runs off the sheet instead of wrapping.
 */
const contactItems = [
  contact.email,
  contact.phone,
  contact.location,
  bare(contact.website),
  bare(contact.linkedin),
  bare(contact.github)
];
---

<article class="sheet">
  <header class="sheet__head">
    <h1 class="sheet__name">{cv.name}</h1>
    <p class="sheet__role" data-role>{cv.role}</p>
    <p class="sheet__headline" data-headline>{headlineOf(cv)}</p>
    <p class="sheet__contact">
      {contactItems.map((item, index) => (
        <>
          {index > 0 && <span class="sep"> | </span>}
          <span>{item}</span>
        </>
      ))}
    </p>
  </header>

  <section class="sheet__section sheet__summary">
    <h2>{labels.summary}</h2>
    {cv.summary.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="sheet__section">
    <h2>{labels.skills}</h2>
    <dl class="sheet__skills" data-groups>
      {cv.skillGroups.map((group) => (
        <div data-group={group.title}>
          <dt>{group.title}</dt>
          <dd data-skills>
            {group.skills.map((skill, index) => (
              <>
                {index > 0 && <span class="sheet__sep">, </span>}
                <span class="sheet__skill" data-skill={skill.name}>
                  {skill.alias?.length ? `${skill.name} (${skill.alias.join(", ")})` : skill.name}
                </span>
              </>
            ))}
            <span class="sheet__stop">.</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="sheet__section">
    <h2>{labels.experience}</h2>
    {cv.positions.map((position, positionIndex) => (
      <div class="sheet__entry" data-position={positionIndex}>
        <h3>{position.title} — {position.company}</h3>
        <p class="sheet__entry-meta">
          {position.start} – {position.end} · {position.employment} · {position.location}
        </p>
        <ul data-highlights>
          {position.highlights.map((highlight) => <li data-highlight={highlight}>{highlight}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section class="sheet__section" data-projects>
    <h2>{labels.projects}</h2>
    {cv.projects.map((project, projectIndex) => (
      <div class="sheet__entry" data-project={projectIndex}>
        <h3>{project.name}</h3>
        <p class="sheet__entry-meta">
          {project.context}
          {project.repository
            ? ` · ${labels.repository}: ${project.repository}`
            : project.url
              ? ` · ${project.url}`
              : ""}
        </p>
        <ul data-highlights>
          {project.highlights.map((highlight) => (
            <li data-highlight={highlight} set:html={inlineCode(highlight)} />
          ))}
        </ul>
        <p class="sheet__stack">{project.stack.join(", ")}.</p>
      </div>
    ))}
    <p class="sheet__note">{cv.otherProjects}</p>
  </section>

  <section class="sheet__section">
    <h2>{labels.education}</h2>
    <ul class="sheet__list">
      {cv.education.map((entry) => (
        <li>
          <strong>{entry.degree}</strong> — {entry.institution}, {entry.period}
          {entry.note ? ` (${entry.note})` : ""}
        </li>
      ))}
    </ul>
  </section>

  <section class="sheet__section">
    <h2>{labels.certifications}</h2>
    <ul class="sheet__list">
      {cv.certifications.map((certification) => (
        <li>
          <strong>{certification.name}</strong> — {certification.issuer}, {certification.issued}
          {certification.credentialId ? ` (ID ${certification.credentialId})` : ""}
        </li>
      ))}
    </ul>
    <p class="sheet__note">
      <strong>{labels.courses}:</strong>{" "}
      {cv.courses.map((course) => `${course.name} (${course.workload})`).join("; ")}.
    </p>
  </section>

  <section class="sheet__section">
    <h2>{labels.languages}</h2>
    <ul class="sheet__list">
      {cv.languages.map((language) => (
        <li><strong>{language.name}</strong> — {language.level}</li>
      ))}
    </ul>
  </section>

  <section class="sheet__section">
    <h2>{labels.keywords}</h2>
    <p class="sheet__keywords">{cv.keywords.join(", ")}.</p>
  </section>
</article>

# Copy this file to `.env` and fill it in. The `.env` file is excluded from git;
# this file is versioned to document available environment variables.
#
# In production, none of this comes from a file: the key is a cluster Secret
# injected by Knative via `secretKeyRef`. See deploy/cloudflare.md and
# .github/workflows/ci.yml.
#
# These variables are declared in astro.config.mjs (`env.schema`) and read via
# `astro:env/server`, so they only exist on the server: importing them from any
# client-bound file is a build error, not a runtime leak.

# OpenAI API key, used exclusively by /print/tailor/.
# Without it, the site starts up normally and only that route indicates no key is set.
OPENAI_API_KEY=

# Models, from cheapest to most capable. Price per million tokens, input /
# output. Cached input bills at one-tenth — the résumé precedes the job
# posting in the prompt precisely to maximize cache hits.
#
#   gpt-5-nano      $0.05 / $0.40   Cheapest. Default for triage.
#   gpt-5-mini      $0.25 / $2.00   One step up, same family
#   gpt-5.6-luna    $0.20 / $1.20   Current baseline. Default for tailor & salary.
#   gpt-5.6-terra   $2.00 / $12.00  Noticeably higher prose quality
#   gpt-5.6-sol     $4.00 / $20.00
#   gpt-6-astra    $10.00 / $50.00  Most capable
#
# A complete generation consumes around 4k input tokens and 1.5k output tokens:
# under $0.001 on nano, around $0.02 on terra.
#
# Only the GPT-5 family onwards supports `reasoning`, which this project sends.
# Models like gpt-4o and gpt-4.1 are not suitable here.
#
# Pipeline models (each defaults to its established code baseline if unset):
#   OPENAI_TRIAGE_MODEL: reads job posting for language, country, level (default: gpt-5-nano)
#   OPENAI_TAILOR_MODEL: adapts the résumé content to the role (default: gpt-5.6-luna)
#   OPENAI_SALARY_MODEL: searches the web for compensation data (default: gpt-5.6-luna)
OPENAI_TRIAGE_MODEL=gpt-5-nano
OPENAI_TAILOR_MODEL=gpt-5.6-luna
OPENAI_SALARY_MODEL=gpt-5.6-luna
